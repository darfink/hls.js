+            !part.loaded &&
+            !part.gap &&
+            part.start <= bufferEnd + 0.0000015 &&
+            part.end > bufferEnd + 0.0000015,
+        )
+      : undefined;
+    if (pendingPart) {
+      return pendingPart.fragment;
+    }
